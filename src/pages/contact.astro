---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact — Noha Khaled">
  <div class="max-w-5xl mx-auto mt-8">
    
    <div class="grid md:grid-cols-2 gap-16 md:gap-24">
      
      <!-- Left Column -->
      <div>
        <h1 class="text-5xl md:text-7xl font-display font-bold tracking-tighter text-onyx mb-6">
          Let's talk
        </h1>
        <p class="text-lg text-dim leading-relaxed mb-8">
          Whether you're hiring for a data role or you've got a data problem that needs fixing, email is the fastest way to reach me.
        </p>

        <div class="p-6 bg-base border border-border rounded-xl">
          <p class="font-mono text-xs text-accent uppercase tracking-wider mb-2">Email</p>
          <!-- Changed IDs to Classes -->
          <button class="copy-email-btn group flex items-center gap-2 text-xl md:text-2xl font-medium text-onyx hover:text-accent transition-[border-color,box-shadow] cursor-pointer" data-email="hello@nohakhalid.com">
            <span class="email-text">hello@nohakhalid.com</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          </button>
          <p class="mt-2 text-sm text-dim">Click to copy. I reply within two business days.</p>
        </div>

        <div class="mt-8 flex items-center gap-6 text-sm font-medium">
          <a href="https://www.linkedin.com/in/nuha-khaled-mahmoud/" target="_blank" rel="noopener noreferrer" class="text-onyx hover:text-accent transition-colors">LinkedIn <span class="text-accent">↗</span></a>
          <a href="https://github.com/NohaKhaled01" target="_blank" rel="noopener noreferrer" class="text-onyx hover:text-accent transition-colors">GitHub <span class="text-accent">↗</span></a>
        </div>
      </div>

      <!-- Right Column: The Form UI -->
      <div class="bg-base p-8 rounded-xl border border-border">
        <h2 class="text-xl font-display font-semibold text-onyx mb-6">Or send a message directly</h2>
        
        <!-- 
          Note: This form requires a backend service (like Formspree or Netlify Forms) to work. 
          For now, it is just the visual UI. 
        -->
                <form action="https://formspree.io/f/xoeeppjo" method="POST" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-dim mb-1">Name</label>
            <input type="text" id="name" name="name" class="w-full bg-base border border-border rounded-md px-4 py-2 text-onyx focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-[border-color,box-shadow]" placeholder="Your name" required />
          </div>
          
          <div>
            <label for="email" class="block text-sm font-medium text-dim mb-1">Email</label>
            <input type="email" id="email" name="email" class="w-full bg-base border border-border rounded-md px-4 py-2 text-onyx focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-[border-color,box-shadow]" placeholder="you@company.com" required />
          </div>

          <div>
            <label for="topic" class="block text-sm font-medium text-dim mb-1">What's this about?</label>
            <select id="topic" name="topic" class="w-full bg-base border border-border rounded-md px-4 py-2 text-onyx focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-[border-color,box-shadow] appearance-none">
              <option value="Hiring">A role / Hiring</option>
              <option value="Project">A project</option>
              <option value="Other">Something else</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-dim mb-1">Message</label>
            <textarea id="message" name="message" rows="4" class="w-full bg-base border border-border rounded-md px-4 py-2 text-onyx focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-[border-color,box-shadow]" placeholder="Tell me a bit about what you need..." required></textarea>
          </div>

          <!-- Formspree spam honeypot (invisible to humans) -->
          <input type="text" name="_gotcha" style="display:none" />

          <button type="submit" class="w-full bg-accent text-base font-medium px-6 py-3 rounded-md hover:bg-accent-dark transition-colors mt-2 cursor-pointer">
            Send Message
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>