---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

// Fetch all projects and sort them by the 'order' number in the frontmatter
const projects = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Layout 
  title="Work — Noha Khaled"
  description="Analytics engineer with 7+ years of engineering problem-solving experience. I build 
  reliable pipelines, data models, and reporting from messy, technical data."
  >
  
  <div class="max-w-5xl">
    <!-- Header -->
    <div class="mb-16">
      <h1 class="text-5xl md:text-7xl font-display font-bold tracking-tighter text-onyx">
        Work
      </h1>
      <p class="mt-6 text-lg md:text-xl text-dim leading-relaxed max-w-3xl">
        Different problems, different builds. Each case study follows the same structure: the problem, the decisions I made, and what I'd do differently.
      </p>
    </div>

    <!-- Dynamic Project Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard 
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          url={`/work/${project.id}`} 
        />
      ))}
    </div>

    <!-- What These Show Section -->
    <section class="mt-24 pt-12 border-t border-border">
      <h2 class="font-mono text-sm text-accent uppercase tracking-wider mb-8">
        What these show
      </h2>
      <div class="grid md:grid-cols-2 gap-8 text-sm md:text-base">
        
        <div>
          <h3 class="font-display font-semibold text-onyx mb-2">Data modeling</h3>
          <p class="text-dim leading-relaxed">Normalized schemas from scratch, star schemas, surrogate keys, and fixing a grain error that had inflated retention figures.</p>
        </div>

        <div>
          <h3 class="font-display font-semibold text-onyx mb-2">Pipeline engineering</h3>
          <p class="text-dim leading-relaxed">ETL and ELT, parent-child load order, orchestration, automation, reruns that don't duplicate data.</p>
        </div>

        <div>
          <h3 class="font-display font-semibold text-onyx mb-2">Data quality</h3>
          <p class="text-dim leading-relaxed">Fuzzy matching with confidence thresholds, duplicate and change detection, reconciliation.</p>
        </div>

        <div>
          <h3 class="font-display font-semibold text-onyx mb-2">Reporting</h3>
          <p class="text-dim leading-relaxed">Power BI, DAX, and data models built for realistic questions.</p>
        </div>

      </div>
    </section>
  </div>
</Layout>