---
interface Props {
  title: string;
  description: string;
  tags: string[];
  url: string;
}

const { title, description, tags, url } = Astro.props;
---

<a href={url} class="group block bg-base border border-border rounded-xl p-8 hover:border-accent hover:shadow-[0_0_20px_rgba(217,138,156,0.1)] transition-[border-color,box-shadow] duration-300">
  <h3 class="text-2xl font-display font-semibold text-onyx">{title}</h3>
  <p class="mt-3 text-dim leading-relaxed">{description}</p>
  
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="font-mono text-xs px-2.5 py-1 rounded bg-accent/10 border border-accent/30 text-accent">
        {tag}
      </span>
    ))}
  </div>
  
  <div class="mt-8 inline-flex items-center gap-2 text-onyx font-medium group-hover:text-accent transition-colors">
    Read the case study <span class="group-hover:translate-x-1 transition-transform text-accent">→</span>
  </div>
</a>